{
  "name": "slop-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:network": "node --import tsx scripts/network-check.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "test:ground": "node --import tsx scripts/ground-check.ts",
    "test:benches": "node --import tsx scripts/benches-check.ts",
    "test:planting": "node --import tsx scripts/planting-check.ts",
    "test:lamp-posts": "node --import tsx scripts/lamp-posts-check.ts",
    "test:fountain": "node --import tsx scripts/fountain-check.ts",
    "test:casino-signage": "node --import tsx scripts/casino-signage-check.ts",
    "test:shop-signage": "node --import tsx scripts/shop-signage-check.ts",
    "test:shop-render": "node --import tsx scripts/shop-rebuild-check.ts",
    "test:signpost": "node --import tsx scripts/signpost-check.ts",
    "test:character": "node --import tsx scripts/character-check.ts",
    "postinstall": "node scripts/patch-sdk.mjs",
    "test:wave": "node --import tsx scripts/wave-check.ts",
    "test:chat": "node --import tsx scripts/chat-browser-check.ts",
    "test:startup": "node --import tsx scripts/startup-check.ts",
    "services:start": "node scripts/services.mjs",
    "services:stop": "node scripts/services.mjs stop",
    "test:social": "node --import tsx scripts/social-check.ts",
    "test:social-persistence": "node --import tsx scripts/social-persistence-check.ts",
    "test:interactions-network": "node --import tsx scripts/player-interactions-network-check.ts",
    "test:interactions-browser": "node --import tsx scripts/player-interactions-browser-check.ts",
    "test:voice": "node --import tsx scripts/voice-check.ts",
    "test:guests": "node --env-file=.env --import tsx scripts/guest-check.ts",
    "test:economy": "node --env-file=.env --import tsx scripts/economy-check.ts",
    "test:shop": "node --import tsx scripts/economy-browser-check.ts",
    "test:casino": "node --env-file=.env --import tsx scripts/casino-check.ts",
    "test:casino-network": "node --import tsx scripts/casino-network-check.ts",
    "test:casino-expansion": "node --import tsx scripts/casino-expansion-check.ts",
    "test:roulette-motion": "node --import tsx scripts/roulette-motion-check.ts",
    "test:craps-render": "node --import tsx scripts/craps-render-check.ts",
    "test:craps-browser": "node --import tsx scripts/craps-browser-check.ts",
    "test:craps-network": "node --import tsx scripts/craps-network-check.ts",
    "test:casino-browser": "node --import tsx scripts/casino-browser-check.ts",
    "test:polish": "node --import tsx scripts/comfort-browser-check.ts && node --import tsx scripts/world-polish-check.ts",
    "test:crowd": "node --import tsx scripts/crowd-render-check.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "deploy:configure": "node scripts/configure-deploy.mjs",
    "test:deployment": "node --import tsx scripts/deployment-check.ts",
    "test:poker-network": "node --import tsx scripts/poker-network-check.ts",
    "test:poker-render": "node --import tsx scripts/poker-render-check.ts",
    "test:poker-browser": "node --import tsx scripts/poker-browser-check.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/loaders": "9.25.0",
    "@babylonjs/materials": "9.25.0",
    "@colyseus/core": "0.18.12",
    "@colyseus/schema": "5.0.27",
    "@colyseus/sdk": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.2.1",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.2.2"
  }
}
