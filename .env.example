# npm run services:start generates private credentials in ignored .env.
# These examples are placeholders; never put service secrets in VITE_ variables.
DATABASE_URL=postgresql://slop_city:REPLACE_ME@127.0.0.1:55432/slop_city
APP_ORIGIN=http://localhost:5173
APP_ORIGINS=http://127.0.0.1:5173
LIVEKIT_URL=ws://127.0.0.1:17880
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
# Browser signalling uses the same-origin /voice proxy by default.

# Town safety and community administration; empty disables login. Never use a plaintext password.
# Generate/store locally with: node scripts/community-admin-password.mjs
COMMUNITY_ADMIN_PASSWORD_HASH=

# Automatic public BridgeMind Twitch status; register a Slop City developer app.
# See docs/cinema-stream-setup.md. Server only, never use VITE_ prefixes.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Production only: generated alongside gateway headers by configure-abuse-proxy.mjs.
# Leave empty for loopback development; never place this secret in VITE_ variables.
ABUSE_PROXY_SECRET=
